# Public — safe to expose to the browser. RLS on the contacts table is what
# actually protects data, not secrecy of these URLs.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Server-only — never committed with real values, never sent to the browser.
# Used only by a human running db/schema.sql once in the Neon SQL editor;
# app code never reads DATABASE_URL at runtime.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server-only — not used by this implementation (it uses the Neon Auth JWT
# forwarding approach instead of the Next.js cookie-session integration), but
# declared here in case that integration path is enabled later.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
